# Generated results and releases never enter Git.
/artifacts/
/release/
/build/
/dist/
/outputs/
/results/
/logs/

# Read-only, locally supplied experimental data.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/research/
/data/reference/

# Python/tool caches and local environments (including accidental old root scratch).
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp*/
.test_tmp/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.ipynb_checkpoints/
.cache/
.venv/
venv/
env/
.conda/
.tox/
.nox/
*.egg-info/
.eggs/
pip-wheel-metadata/
/.task*/
/.t[0-9]*/
/.f_*/
/.g_*/

# Generated numeric data and binaries. Keep small fixtures/inventories by role.
*.csv
*.tsv
*.dat
!/tests/fixtures/*.csv
!/tests/fixtures/**/*.csv
!/tests/fixtures/*.tsv
!/tests/fixtures/**/*.tsv
!/docs/maintenance/*.csv
*.npy
*.npz
*.h5
*.hdf5
*.mat
*.pkl
*.pickle
*.parquet
*.feather
*.opju
*.tif
*.tiff
*.exe
*.dll
*.pyd
*.so
*.dylib
*.whl
*.zip
*.7z
*.tar
*.gz
*.bundle

# Coverage, logs and editor/OS scratch.
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*
.idea/
.vscode/*.local.json
Thumbs.db
desktop.ini
.DS_Store

# Maintained .spec, .ico, .svg, .qm, configs and .agents skills stay visible.
