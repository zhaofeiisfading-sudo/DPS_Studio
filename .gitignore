# ============================================================
# Python bytecode and caches
# ============================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.pytest_tmp/
.pytest_tmp_task*/
.test_tmp/
/.task*_tmp/
/.task*_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# Local Python environments
# Only ignore environments located at the repository root
# ============================================================

/.venv/
/venv/
/env/

# Conda environment export or local metadata
.conda/

# ============================================================
# Build and packaging outputs
# ============================================================

# Only intermediates under build/; verified archives under release/.
# Retain the dist/ ignore as a guard for accidental legacy invocations.
/build/
/dist/
/release/
/artifacts/
*.msi
*.msix
*.dmg
*.AppImage
PDV_Studio*.zip
PDV_Studio*.exe
*.egg-info/
.eggs/
pip-wheel-metadata/

# Do not globally ignore *.spec.
# A maintained PyInstaller spec file should usually be committed.

# ============================================================
# Experimental and generated data
# ============================================================

# Raw experimental data must never enter Git
/data/raw/*
!/data/raw/.gitkeep

# Processed data is generated locally
/data/processed/*
!/data/processed/.gitkeep

# Legacy reference CSV files may contain experimental data
/data/reference/legacy/*.csv

# Local inputs and generated exports from the historical user manual.
/docs/原始数据.csv
/docs/旧软件速度时间数据.csv
/docs/user_manual/export_example*/
/docs/user_manual/PDV_Studio_用户使用说明书.html
/docs/user_manual/PDV_Studio_用户使用说明书.pdf

# Generated program outputs
/outputs/

/results/*
!/results/.gitkeep

/logs/*
!/logs/.gitkeep

# ============================================================
# Notebooks
# ============================================================

.ipynb_checkpoints/

# ============================================================
# IDE and editor local files
# ============================================================

.idea/
.vscode/*.local.json

# Temporary editor files
*.swp
*.swo
*~
~$*

# ============================================================
# Logs and temporary files
# ============================================================

*.log
*.tmp
*.temp
*.bak

# ============================================================
# Operating-system files
# ============================================================

Thumbs.db
desktop.ini
.DS_Store
