# ============================================================
# Python bytecode and caches
# ============================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.pytest_tmp/
.test_tmp/
/.task*_tmp/
/.task*_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
# Local Python environments
# Only ignore environments located at the repository root
# ============================================================

/.venv/
/venv/
/env/

# Conda environment export or local metadata
.conda/

# ============================================================
# Build and packaging outputs
# ============================================================

/build/
/dist/
/release/
*.exe
*.dll
*.pyd
*.so
*.dylib
*.whl
*.zip
*.7z
*.tar
*.gz
*.bundle
*.egg-info/
.eggs/
pip-wheel-metadata/

# Do not globally ignore *.spec.
# A maintained PyInstaller spec file should usually be committed.

# ============================================================
# Experimental and generated data
# ============================================================

# Raw experimental data must never enter Git
/data/raw/*
!/data/raw/.gitkeep

# Processed data is generated locally
/data/processed/*
!/data/processed/.gitkeep

# Legacy reference CSV files may contain experimental data
/data/reference/legacy/*.csv
/data/reference/legacy(旧软件参考速度)/*.csv
# Legacy copied acquisition table; local copy is preserved.
/docs/原始数据.csv
/docs/旧软件速度时间数据.csv

# Generated program outputs
/outputs/

/results/*
!/results/.gitkeep

/logs/*
!/logs/.gitkeep

# ============================================================
# Notebooks
# ============================================================

.ipynb_checkpoints/

# ============================================================
# IDE and editor local files
# ============================================================

.idea/
.vscode/*.local.json

# Temporary editor files
*.swp
*.swo
*~
~$*

# ============================================================
# Logs and temporary files
# ============================================================

*.log
*.tmp
*.temp
*.bak

# ============================================================
# Operating-system files
# ============================================================

Thumbs.db
desktop.ini
.DS_Store

# ============================================================
# DPS Studio Git hygiene - 2026-09-28
# Generated research output stays local. Explicit TASK-013 text sources below
# are versioned; this is not a blanket ban on artifact documentation/config.
# ============================================================

/artifacts/*
!/artifacts/research_clean_task13/
/artifacts/research_clean_task13/*
!/artifacts/research_clean_task13/*.md
!/artifacts/research_clean_task13/__init__.py
!/artifacts/research_clean_task13/repro/
/artifacts/research_clean_task13/repro/*
!/artifacts/research_clean_task13/repro/*.py
!/artifacts/research_clean_task13/repro/*.ps1
!/artifacts/research_clean_task13/repro/*.toml

# Generated numeric arrays, scientific exports, native plotting projects.
*.npy
*.npz
*.h5
*.hdf5
*.opju
*.tif
*.tiff

# Local metadata backups / scratch. Maintained .spec and configs remain visible.
/.task13_*/

# pytest / research scratch directories
/.pytest_tmp*/
/.task*_pytest*/
/.task_gui_baseline_tmp_*/
/.f_*/
/.g_*/
/.t*_full/
/.t*_unit/
/.t*_verify/

# Python/tool caches
/.mypy_cache/
/.ruff_cache/
/.pytest_cache/
__pycache__/
*.py[cod]

